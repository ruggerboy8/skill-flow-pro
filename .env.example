# Environment variables for Skill Flow Pro.
#
# `.env` itself is committed to this repo (see README.md, "About the
# committed .env"). This file documents what each variable does; copy it to
# `.env` if you need a clean starting point, but note the real `.env` already
# has working values checked in.
#
# None of these are secrets today — all are publishable/anon-level values or
# non-secret feature flags. Never put a real secret (a service-role key, a
# database password, a management API token) in this file or in `.env`.

# --- Supabase connection ---
# NOT actually read by the app today: the Supabase URL and anon (publishable)
# key are hardcoded directly in src/integrations/supabase/client.ts, so these
# four variables have no effect on the running app right now. They're listed
# here because they're already in the committed .env; changing them will not
# change which Supabase project the app talks to.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# --- Feature flags ---

# Shows an admin-only "Sim Console" debug panel (src/devtools/SimConsole.tsx)
# for simulating check-in/check-out state. Read in src/main.tsx,
# src/components/Layout.tsx, and src/components/home/ThisWeekPanel.tsx. Even
# when "true", the console only renders for two hardcoded admin emails in
# Layout.tsx. Because Vite inlines VITE_* values at build time, this value at
# build time controls whether the console ships in the bundle at all.
VITE_ENABLE_SIMTOOLS="true"

# NOT currently read anywhere in src/ (checked via grep across the whole
# codebase). Was presumably wired to something at some point; whatever read
# it has since been removed or renamed. Setting this does nothing today.
VITE_APP_MODE="v2"

# NOT currently read anywhere in src/ (checked via grep across the whole
# codebase). Same situation as VITE_APP_MODE above: a leftover flag with no
# live consumer. Setting this does nothing today.
VITE_USE_WEEKLY_ASSIGNMENTS="true"
