# Copy this file to demo-capture/.env and fill in real values.
# demo-capture/.env is gitignored -- never commit it.

# Where the app under capture is running. Defaults to the local Vite dev
# server (npm run dev, port 8080). Point this at a preview/build server if
# you're capturing a production build instead (see README "SIMTOOLS note").
DEMO_CAPTURE_BASE_URL=http://localhost:8080

# Run headed (a visible browser window) instead of headless. Useful for the
# DEMO-1c dry run so a human can watch each clip record; leave "false" for
# the real unattended capture runs.
DEMO_CAPTURE_HEADED=false

# How many times Playwright retries a clip that fails before giving up.
DEMO_CAPTURE_RETRIES=2

# Demo login credentials (created by scripts/demo-seed -- DEMO-1a). The
# script's fixed cast (scripts/demo-seed/cast.ts) always creates these three
# addresses; only override the *_EMAIL vars if the demo org is ever reseeded
# under a different domain.
# DEMO_STAFF_EMAIL=demo-staff@bluebird.demo
DEMO_STAFF_PASSWORD=
# DEMO_COACH_EMAIL=demo-coach@bluebird.demo
DEMO_COACH_PASSWORD=
# DEMO_ADMIN_EMAIL=demo-admin@bluebird.demo
DEMO_ADMIN_PASSWORD=

# Which login persona records each clip. Only needed if a DEMO-1c dry run
# finds the seeded demo org's role flags don't match the spec's assumption
# (see each spec file's "ACCESS NOTE" for why this might happen). Values:
# staff | coach | admin.
# DEMO_CLIP1_LOGIN=staff
# DEMO_CLIP2_LOGIN=coach
# DEMO_CLIP3_LOGIN=coach
# DEMO_CLIP4_LOGIN=coach
# DEMO_CLIP5_LOGIN=admin

# Clip 4's typed observation, polished live into a glow and a grow. See
# specs/04-evaluation-glows-grows.spec.ts for why this is typed, not spoken.
# DEMO_CLIP4_FEEDBACK_TEXT=
