# Copy this file to scripts/demo-seed/.env and fill in real values.
# scripts/demo-seed/.env is gitignored -- never commit it, never commit a
# real service role key or password anywhere in this repo.

# Supabase project connection. The SERVICE ROLE key bypasses Row Level
# Security, which is why this script must only ever be run from a trusted
# local machine, never committed, never pasted into a shared channel.
SUPABASE_URL=https://yeypngaufuualdfzcjpk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Real, memorable passwords for the three demo login personas the capture
# harness (DEMO-1b) will log in as. Pick something you can type on stage.
# Every other copied cast member also gets an auth user (staff.user_id is
# NOT NULL), but with a random password nobody is ever meant to use.
DEMO_STAFF_PASSWORD=
DEMO_COACH_PASSWORD=
DEMO_ADMIN_PASSWORD=
